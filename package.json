{
  "name": "myraa",
  "productName": "MYRAA",
  "description": "MYRAA — a private 3D AI desktop companion powered by each user's own Gemini API key.",
  "author": "Aarav",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mmd-parser": "^1.0.4",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.180.0",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.myraa.desktop",
    "productName": "MYRAA",
    "directories": {
      "output": "release_dist"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/**",
      "resources/**",
      "public/**",
      "icon.*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/agent/clicker.exe",
        "to": "agent/clicker.exe"
      },
      {
        "from": "build",
        "to": "build"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "MYRAA-Portable-${version}.exe"
    }
  }
}